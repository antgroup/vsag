  "rounds": 1,
  "hash_files": false,
  "acceptance": {
    "qps_min_pct": 15,
    "p99_max_regression_pct": 10,
    "recall_max_abs_change": 0.01,
    "target_concurrency": [8, 16, 32]
  },
  "baseline": {
    "eval_binary": "/mnt/data/vsag-builds/baseline/tools/eval/eval_performance"
  },
  "candidate": {
    "eval_binary": "/mnt/data/vsag-builds/candidate/tools/eval/eval_performance"
