global:
  num_threads_building: 16
  num_threads_searching: 16
  exporters:
    stdout:
      format: table
      to: stdout
    raw-json:
      format: json
      to: "file://@RESULT_JSON@"

saq_build:
  datapath: "@DATASET@"
  type: build
  index_name: hgraph
  create_params: '{"dim":@DIM@,"dtype":"float32","metric_type":"l2","index_param":{"base_quantization_type":"saq","saq_avg_bits":4,"saq_segment_count":0,"saq_adjustment_rounds":6,"saq_use_pca":true,"saq_random_rotation":true,"max_degree":32,"ef_construction":300,"build_thread_count":16,"use_reorder":false}}'
  index_path: "@INDEX_ROOT@/saq.index"

